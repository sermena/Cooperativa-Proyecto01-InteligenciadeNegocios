    cuota_mensual,
    tasa_interes_anual,
    estado_credito,
    fecha_desembolso -- Dejamos la fecha limpia para buscarla contra dim_tiempo
FROM credito;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
