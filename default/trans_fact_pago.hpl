  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    p.id_pago AS id_pago_oltp,
    p.id_credito AS id_credito_oltp,
    p.id_canal,
    p.numero_cuota,
    p.fecha_pago,
    p.dias_atraso,
    p.monto_principal,
    p.monto_interes,
    p.monto_interes_moratorio,
    p.monto_total,
    c.id_cliente,
    c.id_producto,
    c.id_agencia
FROM pago p
INNER JOIN credito c ON p.id_credito = c.id_credito;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DB_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
