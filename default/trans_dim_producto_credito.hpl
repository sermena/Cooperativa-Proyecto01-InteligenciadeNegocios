  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    p.id_producto AS id_producto_oltp,
    p.codigo_producto,
    p.nombre_producto,
    t.nombre_tipo AS nombre_tipo_credito,
    t.tipo_garantia,
    p.moneda,
    p.monto_minimo,
    p.monto_maximo,
    p.plazo_minimo_meses,
    p.plazo_maximo_meses,
    p.activo
FROM producto_credito p
JOIN tipo_credito t ON p.id_tipo_credito = t.id_tipo_credito;</sql>
    <limit>0</limit>
