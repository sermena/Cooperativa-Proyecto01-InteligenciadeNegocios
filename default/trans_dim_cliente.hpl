  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    c.id_cliente AS id_cliente_oltp,
    CONCAT(c.nombre, ' ', c.primer_apellido, ' ', COALESCE(c.segundo_apellido, '')) AS nombre_completo,
    c.numero_identificacion,
    c.fecha_nacimiento,
    c.fecha_ingreso,
    s.codigo_segmento,
    s.nombre_segmento,
    u.provincia,
    u.canton,
    LEFT(r.nombre_region, 10) AS codigo_region,
    r.nombre_region AS nombre_region,
    COALESCE(c.activo, true) AS activo -- Asegura que nunca vaya nulo si la tabla origen lo tiene
FROM cliente c
JOIN segmento s ON c.id_segmento = s.id_segmento
JOIN ubicacion u ON c.id_ubicacion = u.id_ubicacion
JOIN region r ON u.id_region = r.id_region;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DB_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>240</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
