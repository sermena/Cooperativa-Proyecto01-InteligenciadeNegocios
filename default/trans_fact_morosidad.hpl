  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    m.id_morosidad AS id_morosidad_oltp,
    m.id_credito AS id_credito_oltp,
    m.fecha_corte,
    m.saldo_pendiente,
    m.cuotas_atrasadas,
    m.monto_atrasado,
    m.dias_atraso,
    m.id_rango,
    c.id_cliente,
    c.id_producto,
    c.id_agencia
FROM morosidad m
INNER JOIN credito c ON m.id_credito = c.id_credito;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DB_OLTP</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>96</yloc>
    </GUI>
