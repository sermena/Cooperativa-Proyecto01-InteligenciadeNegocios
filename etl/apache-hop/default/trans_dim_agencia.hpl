  <transform>
    <type>TableInput</type>
    <name>Table input</name>
    <sql>SELECT 
    a.id_agencia AS id_agencia_oltp,
    a.codigo_agencia,
    a.nombre_agencia,
    u.provincia,
    u.canton,
    r.codigo_region,
    r.nombre_region,
    a.fecha_apertura,
    a.activa
FROM agencia a
JOIN ubicacion u ON a.id_ubicacion = u.id_ubicacion
JOIN region r ON u.id_region = r.id_region;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>DB_OLTP</connection>
